<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hongyun.mapper.UserMapper">

    <select id="getAll" resultType="com.hongyun.entity.User">
        SELECT * FROM user
    </select>

    <insert id="insert" parameterType="com.hongyun.entity.User">
        insert into user (name, email, password, head_image, create_time, update_time) values (#{name}, #{email}, #{password}, #{headImage}, now(), now());
    </insert>


    <select id="findByEmail" resultType="com.hongyun.entity.User">
        select * from user where email = #{email}
    </select>

    <update id="updatePassword" parameterType="com.hongyun.entity.User">
        update user set password = #{password} where email = #{email}
    </update>

    <update id="updateUserInfo" parameterType="com.hongyun.entity.User">
        UPDATE user
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="headImage != null">
                head_image = #{headImage},
            </if>
            update_time = now()
        </set>
        WHERE email = #{email}
    </update>

</mapper>